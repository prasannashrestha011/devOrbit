{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevOrbit",
  "version": "0.1.0",
  "identifier": "com.devorbit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevOrbit",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 600,
        "backgroundColor": "#10151d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420"
    }
  },
  "bundle": { "active": true, "icon": ["icons/icon.png"] }
}
