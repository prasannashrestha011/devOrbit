# Copy to server/.env; exported environment variables take precedence.
DEVORBIT_HOST=127.0.0.1
DEVORBIT_PORT=7456
# SQLite is created automatically at <DEVORBIT_DATA_DIR>/devorbit.db.
# DEVORBIT_DATA_DIR=/absolute/path/to/private/devorbit
# DEVORBIT_LOG_DIR=/absolute/path/to/private/devorbit/logs
DEVORBIT_SHUTDOWN_TIMEOUT=10s
# DEVORBIT_AUTH_TOKEN_PATH=/absolute/path/to/private/devorbit/auth-token
